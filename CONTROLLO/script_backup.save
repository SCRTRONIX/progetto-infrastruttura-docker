!/bin/bash


PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin


CONTAINER_NAME="il_tuo_container"
DB_USER="root"
DB_PASS="la_tua_password"
DB_NAME="il_tuo_db"
BACKUP_DIR="/var/backups/mariadb"
DAYS_TO_KEEP=7


mkdir -p "$BACKUP_DIR"


TIMESTAMP=$(date +'%Y-%m-%d_%H%M')
BACKUP_FILE="$BACKUP_DIR/backup_${DB_NAME}_${TIMESTAMP}.sql.gz"


docker exec -i "$CONTAINER_NAME" mariadb-dump -u "$DB_USER" -p"$DB_PASS" "$DB_NAME" | gzip > "$BACKUP_FILE"


find "$BACKUP_DIR" -type f -name "backup_${DB_NAME}_*.sql.gz" -mtime +$DAYS_TO_KEEP -delete
